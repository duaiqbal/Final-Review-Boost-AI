# Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste_your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
# Optional backup model, tried once if the primary is unavailable:
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Admin panel login password (choose a strong one)
ADMIN_PASSWORD=change_this_password

# Long random text. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=paste_long_random_text_here

# Your Vercel frontend address. QR codes encode this + /review/<business_id>.
# If this is wrong, every QR code opens the wrong site.
FRONTEND_BASE_URL=https://review-bost-ai-frontend.vercel.app

# Allowed browser origins (comma separated)
ALLOWED_ORIGINS=https://review-bost-ai-frontend.vercel.app,http://localhost:3000

# SQLite file. On Railway, put it on a mounted volume (e.g. /data/reviewboost.db)
# or data is lost on every redeploy.
DATABASE_PATH=reviewboost.db
